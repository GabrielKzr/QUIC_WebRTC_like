table ip nat {
	map fullcone {
		type inet_service : ipv4_addr . inet_service
		size 65536
		flags dynamic,timeout
		timeout 5m
	}

	set opened_ports {
		type inet_service
		size 65535
		flags dynamic,timeout
		timeout 5m
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iif "wan" dnat ip to udp dport map @fullcone
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oif "wan" update @fullcone { udp sport timeout 5m : ip saddr . udp sport }
		oif "wan" update @opened_ports { udp sport timeout 5m }
		oif "wan" meta l4proto udp snat to 10.0.0.2:udp sport
	}

	chain inbound_guard {
		type filter hook prerouting priority raw; policy accept;
		iif "wan" udp dport != @opened_ports drop
	}
}
table ip filter {
	chain forward {
		type filter hook forward priority filter; policy accept;
		iif "wan" ct state established,related accept
		iif "wan" drop
	}
}
