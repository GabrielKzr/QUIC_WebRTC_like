{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "all",
      "displayName": "Todos os testes",
      "description": "Compila as classes WebRTC e OpenSSL e habilita todas as regressões Patchbay.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/all",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "BUILD_WEBRTC_TESTS": true,
        "BUILD_OPENSSL_TESTS": true,
        "BUILD_NETWORK_TESTS": true,
        "BUILD_NICE_TESTS": true,
        "TEST_NAME": null,
        "BUILD_LONG_TESTS": false
      }
    },
    {
      "name": "long",
      "inherits": "all",
      "displayName": "Sessão prolongada QUIC/ICE/TURN",
      "binaryDir": "${sourceDir}/build/long",
      "cacheVariables": {
        "BUILD_LONG_TESTS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "all",
      "configurePreset": "all"
    },
    {
      "name": "long",
      "configurePreset": "long",
      "targets": [
        "test_quic_ice_turn_long",
        "patchbay_runner"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "all",
      "configurePreset": "all",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "long",
      "configurePreset": "long",
      "filter": {
        "include": {
          "label": "long"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
