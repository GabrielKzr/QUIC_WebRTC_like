digraph "QUIC_WebRTC_Like" {
node [
  fontsize = "12"
];
subgraph clusterLegend {
  label = "Legend";
  color = black;
  edge [ style = invis ];
  legendNode0 [ label = "Executable", shape = egg ];
  legendNode1 [ label = "Static Library", shape = octagon ];
  legendNode2 [ label = "Shared Library", shape = doubleoctagon ];
  legendNode3 [ label = "Module Library", shape = tripleoctagon ];
  legendNode4 [ label = "Interface Library", shape = pentagon ];
  legendNode5 [ label = "Object Library", shape = hexagon ];
  legendNode6 [ label = "Unknown Library", shape = septagon ];
  legendNode7 [ label = "Custom Target", shape = box ];
  legendNode0 -> legendNode1 [ style = solid ];
  legendNode0 -> legendNode2 [ style = solid ];
  legendNode0 -> legendNode3;
  legendNode1 -> legendNode4 [ label = "Interface", style = dashed ];
  legendNode2 -> legendNode5 [ label = "Private", style = dotted ];
  legendNode3 -> legendNode6 [ style = solid ];
  legendNode0 -> legendNode7;
}
    "node0" [ label = "chownat", shape = octagon ];
    "node1" [ label = "udp_conn", shape = octagon ];
    "node2" [ label = "utils", shape = octagon ];
    "node1" -> "node2"  // udp_conn -> utils
    "node0" -> "node1"  // chownat -> udp_conn
    "node0" -> "node2"  // chownat -> utils
    "node3" [ label = "ossl_quic", shape = octagon ];
    "node4" [ label = "OpenSSL::Crypto", shape = septagon ];
    "node3" -> "node4"  // ossl_quic -> OpenSSL::Crypto
    "node5" [ label = "OpenSSL::SSL", shape = septagon ];
    "node5" -> "node4" [ style = dashed ] // OpenSSL::SSL -> OpenSSL::Crypto
    "node3" -> "node5"  // ossl_quic -> OpenSSL::SSL
    "node3" -> "node1"  // ossl_quic -> udp_conn
    "node3" -> "node2"  // ossl_quic -> utils
    "node6" [ label = "protocols", shape = octagon ];
    "node6" -> "node0"  // protocols -> chownat
    "node6" -> "node3"  // protocols -> ossl_quic
    "node7" [ label = "quic_like", shape = octagon ];
    "node7" -> "node1"  // quic_like -> udp_conn
    "node7" -> "node2"  // quic_like -> utils
    "node6" -> "node7"  // protocols -> quic_like
    "node6" -> "node1"  // protocols -> udp_conn
}
